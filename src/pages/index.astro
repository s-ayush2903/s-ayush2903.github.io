---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Dev Portfolio & Blog">
  <main class="mx-auto max-w-3xl px-6 py-16">
    <section>
      <h1 class="text-3xl font-bold tracking-tight text-foreground">
        Hey, I'm <span class="text-primary">Your Name</span>
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-muted-foreground">
        Software developer who enjoys building reliable systems and writing about the craft.
        I work across the stack — from React frontends to containerized backends — and like
        exploring the edges of what's possible with modern tooling.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="font-mono text-sm font-semibold uppercase tracking-wider text-muted-foreground">
        Currently
      </h2>
      <p class="mt-3 text-foreground leading-relaxed">
        Building developer tools and writing about TypeScript, systems design, and DevOps.
        Previously shipped production code at startups and enterprise teams alike.
      </p>
    </section>

    <section class="mt-12">
      <h2 class="font-mono text-sm font-semibold uppercase tracking-wider text-muted-foreground">
        Elsewhere
      </h2>
      <div class="mt-3 flex flex-wrap gap-4">
        <a
          href="https://github.com"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-sm text-primary underline underline-offset-2 hover:text-primary/80 transition-colors"
        >GitHub</a>
        <a
          href="https://linkedin.com"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-sm text-primary underline underline-offset-2 hover:text-primary/80 transition-colors"
        >LinkedIn</a>
        <a
          href="https://x.com"
          target="_blank"
          rel="noopener noreferrer"
          class="font-mono text-sm text-primary underline underline-offset-2 hover:text-primary/80 transition-colors"
        >Twitter / X</a>
      </div>
    </section>

    <section class="mt-12">
      <h2 class="font-mono text-sm font-semibold uppercase tracking-wider text-muted-foreground">
        Writing
      </h2>
      <p class="mt-3 text-foreground leading-relaxed">
        I write about things I learn and build.{' '}
        <a href="/blog" class="text-primary underline underline-offset-2 hover:text-primary/80 transition-colors">
          Check out the blog →
        </a>
      </p>
    </section>
  </main>
</Layout>
