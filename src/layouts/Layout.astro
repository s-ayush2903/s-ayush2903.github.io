---
import '../index.css';
import Navbar from '../components/Navbar';
import ClientRouter from 'astro/components/ClientRouter.astro';
import { SITE_NAME } from '../lib/constants';

const pathname = Astro.url.pathname;

interface Props {
  title?: string;
  description?: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: string;
  ogPublishedTime?: string;
  ogModifiedTime?: string;
}

const {
  title = SITE_NAME,
  description = 'Ayush Shrivastava — Backend engineer. Distributed systems, JVM internals, and the occasional opinion.',
  ogTitle = title,
  ogDescription = description,
  ogType = 'website',
  ogPublishedTime,
  ogModifiedTime,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:type" content={ogType} />
    <meta property="og:image" content="https://s-ayush2903.github.io/og.png" />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE_NAME} — Ayush Shrivastava`} />
    {ogPublishedTime && <meta property="article:published_time" content={ogPublishedTime} />}
    {ogModifiedTime && <meta property="article:modified_time" content={ogModifiedTime} />}

    <ClientRouter />

    <!-- Prevent flash of wrong theme on load -->
    <script is:inline>
      (function () {
        var stored = localStorage.getItem('theme');
        var dark = stored
          ? stored === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
        var palette = localStorage.getItem('palette');
        if (palette && palette !== 'default')
          document.documentElement.setAttribute('data-theme', palette);
      })();
    </script>
  </head>

  <body>
    <Navbar client:load pathname={pathname} />
    <slot />

    <!-- Copy-to-clipboard for Shiki-rendered code blocks -->
    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const COPY_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>`;
        const CHECK_ICON = `<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>`;

        document.querySelectorAll<HTMLElement>('pre.astro-code:not([data-language="mermaid"])').forEach(pre => {
          // Wrap pre in .code-block-wrapper
          const wrapper = document.createElement('div');
          wrapper.className = 'code-block-wrapper';
          pre.parentNode!.insertBefore(wrapper, pre);
          wrapper.appendChild(pre);

          // Create copy button
          const btn = document.createElement('button');
          btn.className = 'copy-code-button';
          btn.setAttribute('aria-label', 'Copy code');
          btn.innerHTML = COPY_ICON;

          btn.addEventListener('click', () => {
            const code = pre.querySelector('code');
            const text = code?.textContent ?? '';
            navigator.clipboard.writeText(text).then(() => {
              btn.setAttribute('aria-label', 'Copied');
              btn.innerHTML = CHECK_ICON;
              setTimeout(() => {
                btn.setAttribute('aria-label', 'Copy code');
                btn.innerHTML = COPY_ICON;
              }, 2000);
            });
          });

          wrapper.appendChild(btn);
        });
      });
    </script>
  </body>
</html>
